    {
      "name": "Back-Office (no terminal required)",
      "description": "Operations that run server-side — no terminal interaction, no cardholder present.\n\nThese are synchronous (return a result immediately, not 202 Accepted).\n\nAuthentication: same `ApiKeyCloud` header as card-present operations.",
      "item": [
        {
          "name": "Remote Reversal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"saleReversal\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Reversal submitted directly to the Cloud — does not require the terminal to be actively connected.\n\nMust be sent before the daily batch close. After batch close, use a Refund instead.\n\nThe `serial_number` and `terminal_type` still identify which merchant/terminal the reversal belongs to."
          },
          "response": [
            {
              "name": "200 OK — reversed",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"agreementNumber\": \"123456789010102\",\n  \"cardToken\": \"\",\n  \"cardTokenizationGuid\": \"\",\n  \"expiryDateMMYY\": \"1027\",\n  \"httpStatus\": 200,\n  \"maskedCardNumber\": \"************0936\",\n  \"serverDateTime\": \"2025-06-10T15:32:00Z\",\n  \"transactionReference\": \"2bfde1fc-23b1-4c67-93d9-1d4a557f4d4f\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "400 — already reversed",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"code\": \"3051\",\n  \"message\": \"Transaction already reversed.\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "400 — not found",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"code\": \"3153\",\n  \"message\": \"Unable to find message to reverse.\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Partial Reversal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"saleReversal\",\n  \"amount\": \"500\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Reverse only part of an authorised amount. The cardholder does not need to re-present their card.\n\nSet `amount` to the portion you want to release. The remaining `originalAmount - amount` stays authorised.\n\nAcquirer support varies — check the Acquirer Capabilities Matrix."
          },
          "response": []
        },
        {
          "name": "Tip Adjustment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"tipAdjustment\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"tipAmount\": \"200\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Add a tip to an already-authorised sale, before batch close. The settlement amount is updated to `originalAmount + tipAmount`.\n\n**This is different from Sale with Tip** — Tip Adjustment is a post-auth back-office operation; Sale with Tip collects the tip at the terminal before authorisation.\n\nUse Tip Adjustment for tip-on-receipt / tip-at-table workflows where the customer writes their tip on a paper receipt and the server enters it later.\n\nAcquirer support: EPI (TSYS), Paysafe + Interac. Not available on EmerchantPay or Paystrax.\n\nMust be sent before the daily batch close."
          },
          "response": []
        },
        {
          "name": "Remote Sale (MOTO)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"moToSale\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"cardToken\": \"{{card_token}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Card-not-present sale using a stored token from a previous Sale and Tokenize.\n\nNo terminal or cardholder required. Uses the stored card for a new charge.\n\n**cardToken** — obtained from a prior `saleAndTokenizeCard` result.\n\nFor key-entry MOTO (operator types card number), use the Key Entry Sale on the acquirer page instead.\n\nAcquirer support: EPI (TSYS), EmerchantPay. Not available on Paysafe or Paystrax."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pre-Authorization Flow",
      "description": "Pre-authorization places a hold on the cardholder's funds without immediately settling. The full lifecycle:\n\n1. **Create** (card-present) — cardholder taps/inserts; hold placed\n2. **Increase / Decrease** (back-office) — adjust the hold amount\n3. **Capture** (back-office) — settle the final amount\n4. **Pre-Auth Reversal** (back-office) — release the hold without charging\n5. **Capture Reversal** (back-office) — undo a capture before settlement\n\nOnly Create requires the terminal. All subsequent steps are back-office API calls.",
      "item": [
        {
          "name": "1. Pre-Auth Create (card-present)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "  const r = Math.random() * 16 | 0;",
                  "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "});",
                  "pm.collectionVariables.set('transaction_reference', uuid());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionResultId) pm.collectionVariables.set('transaction_result_id', body.transactionResultId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"preAuthorization\",\n  \"amount\": \"5000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"transactionReference\": \"{{transaction_reference}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Places a hold on the cardholder's funds. The cardholder must be present at the terminal.\n\nSave the `transactionID` from the AUTHORISED result — needed for all subsequent operations in the lifecycle.\n\nTypical uses: hotel check-in, restaurant tabs, car rental, medical procedures with uncertain final cost."
          },
          "response": []
        },
        {
          "name": "2a. Pre-Auth Increase",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"preAuthorizationIncrease\",\n  \"amount\": \"7500\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Increase the hold amount. Back-office — no terminal or cardholder required.\n\n`amount` is the **new total hold amount**, not the increment. If the original hold was $50.00 and you want to increase to $75.00, send `\"amount\": \"7500\"`."
          },
          "response": []
        },
        {
          "name": "2b. Pre-Auth Decrease",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"preAuthorizationDecrease\",\n  \"amount\": \"3000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Decrease the hold amount. Back-office — no terminal or cardholder required.\n\n`amount` is the **new total hold amount**."
          },
          "response": []
        },
        {
          "name": "3. Pre-Auth Capture",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalGuid\": \"{{last_transaction_id}}\",\n  \"capturedAmount\": \"4800\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/preauthorization/capture",
              "host": ["{{base_url}}"],
              "path": ["preauthorization", "capture"]
            },
            "description": "Settle a pre-authorization — charges the card for `capturedAmount` and releases the remaining hold.\n\nNote: this uses a **different endpoint** from other operations (`/preauthorization/capture`, not `/transactions`).\n\n`capturedAmount` can be less than the original hold. It cannot exceed the current hold amount."
          },
          "response": []
        },
        {
          "name": "4a. Pre-Auth Reversal (release hold)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"preAuthorizationReversal\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Release the entire hold without charging the cardholder. Use when the service or transaction is cancelled.\n\nBack-office — no terminal or cardholder required."
          },
          "response": []
        },
        {
          "name": "4b. Capture Reversal (undo capture)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"preAuthorizationCaptureReversal\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"transactionReference\": \"new-uuid-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Reverse a capture before it settles in the batch. Use if a capture was sent in error.\n\nMust be sent before the daily batch close. Back-office — no terminal required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transaction Result",
      "description": "Retrieve transaction outcomes by ID. Use when polling (no callbackUrl) or to recover a result after a server crash.",
      "item": [
        {
          "name": "Get by transactionResultId",
          "request": {
            "method": "GET",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transaction-result/{{transaction_result_id}}",
              "host": ["{{base_url}}"],
              "path": ["transaction-result", "{{transaction_result_id}}"]
            },
            "description": "Poll this endpoint after a transaction when no callbackUrl was provided.\n\n`transactionResultId` is in the 202 Accepted body (saved automatically by the test scripts in this collection).\n\nPoll every 2 seconds. Stop when `finStatus` is anything other than `IN_PROGRESS` or `UNDEFINED`.\n\nFinal statuses: AUTHORISED, DECLINED, FAILED, CANCELLED, PARTIALLY_APPROVED, REFUNDED, CAPTURED, PROCESSED."
          },
          "response": [
            {
              "name": "IN_PROGRESS",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"finStatus\": \"IN_PROGRESS\",\n  \"transactionID\": null,\n  \"statusMessage\": \"In Progress\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "AUTHORISED",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"finStatus\": \"AUTHORISED\",\n  \"transactionID\": \"e6254050-65ab-11f1-a9af-ffa530c6e21f\",\n  \"transactionReference\": \"2bfde1fc-23b1-4c67-93d9-1d4a557f4d4f\",\n  \"type\": \"SALE\",\n  \"statusMessage\": \"Approved\",\n  \"errorMessage\": \"\",\n  \"requestedAmount\": 1000,\n  \"totalAmount\": 1000,\n  \"currency\": \"USD\",\n  \"cardSchemeName\": \"Visa\",\n  \"maskedCardNumber\": \"************0936\",\n  \"authorisationCode\": \"123456\",\n  \"issuerResponseCode\": \"00\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Get by transactionReference (recovery)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/{{transaction_reference}}",
              "host": ["{{base_url}}"],
              "path": ["transactions", "{{transaction_reference}}"]
            },
            "description": "Recovery endpoint — use when your server crashed, the callback was not received, or you need to look up a transaction by your own reference.\n\nThe `transactionReference` is the UUID v4 you sent in the original POST. This is why you persist it to your database before the request.\n\nIf the result is AUTHORISED and you have no prior record of it, send an automatic reversal to prevent a double-charge."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Batch Operations (EPI / TSYS only)",
      "description": "Batch operations are only available on the EPI and Paysafe+Interac acquirers.\n\nThe batch contains all unsettled transactions for the day. Closing the batch triggers settlement with the acquirer.\n\nIf you do not explicitly close the batch, the acquirer closes it automatically at a configured cut-off time.",
      "item": [
        {
          "name": "Batch Close",
          "request": {
