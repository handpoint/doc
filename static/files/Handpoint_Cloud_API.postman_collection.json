              "raw": "{\n  \"operation\": \"saleReversal\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"transactionReference\": \"{{transaction_reference}}\"\n}",
