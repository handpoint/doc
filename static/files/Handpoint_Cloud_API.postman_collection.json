            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"refund\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"originalTransactionId\": \"{{last_transaction_id}}\",\n  \"transactionReference\": \"{{transaction_reference}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "On-device refund — the cardholder must present their card at the terminal.\n\n**originalTransactionId** — the `transactionID` from the original AUTHORISED sale result. Required for a linked refund (recommended). Without it, the refund is unlinked.\n\n**amount** — can be less than the original amount for a partial refund. Cannot exceed the original amount.\n\nFor a refund without requiring the cardholder to be present, use Remote Reversal (back-office) instead."
          },
          "response": []
        },
        {
          "name": "Reversal (on-device)",
          "event": [
