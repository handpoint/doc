{
  "info": {
    "_postman_id": "c3e7b8a1-2d4f-4e8a-9c6b-5a3d1e7f2c90",
    "name": "Handpoint Cloud API",
    "description": "Complete Handpoint Cloud REST API collection.\n\n**Setup**\n1. Set the `api_key` collection variable to your merchant API key (from Handpoint Integration Support).\n2. Set `serial_number` to your PAX terminal serial number (Payments App → Settings → About).\n3. Set `terminal_type` to your terminal model (e.g. `PAXA920`, `PAXA920PRO`, `PAXA35`).\n4. Choose an environment: **DEMO (Production)** for tests on a production PAX with a DEMO merchant, or **Staging** for a PAX debug device.\n\n**Environments vs. base_url**\n- `https://cloud.handpoint.com` — production PAX terminals (DEMO and live merchants)\n- `https://cloud.handpoint.io` — staging/debug PAX terminals only\n\n`.io` and `.com` credentials are not interchangeable. When a merchant goes live, new credentials are issued.\n\n**Transaction flow**\n1. `POST /transactions` → 202 Accepted + `transactionResultId`\n2. Terminal processes the card\n3. Result delivered via callback POST to your `callbackUrl`, OR poll `GET /transaction-result/{transactionResultId}`\n\nDocumentation: https://developer.handpoint.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://cloud.handpoint.com",
      "type": "string",
      "description": "Use https://cloud.handpoint.io for staging/debug terminals"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string",
      "description": "Your merchant API key — set this before running any request"
    },
    {
      "key": "terminal_type",
      "value": "PAXA920",
      "type": "string",
      "description": "PAX terminal model. Common values: PAXA920, PAXA920PRO, PAXA35, PAXA77"
    },
    {
      "key": "serial_number",
      "value": "",
      "type": "string",
      "description": "Terminal serial number — found in Payments App > Settings > About"
    },
    {
      "key": "callback_url",
      "value": "",
      "type": "string",
      "description": "Your HTTPS endpoint to receive transaction results. Must use a CA-trusted TLS certificate (not self-signed)."
    },
    {
      "key": "webhook_token",
      "value": "my-secret-webhook-token",
      "type": "string",
      "description": "Echoed as the AUTH-TOKEN header in callbacks. Validate this on receipt."
    },
    {
      "key": "transaction_result_id",
      "value": "",
      "type": "string",
      "description": "Auto-populated from the last transaction's 202 response. Use in GET /transaction-result."
    },
    {
      "key": "last_transaction_id",
      "value": "",
      "type": "string",
      "description": "transactionID from the last AUTHORISED result. Use for reversals, tip adjustments, and captures."
    },
    {
      "key": "transaction_reference",
      "value": "",
      "type": "string",
      "description": "Auto-generated UUID per request. Persist this BEFORE the POST for recovery."
    },
    {
      "key": "card_token",
      "value": "",
      "type": "string",
      "description": "Card token returned from a Sale and Tokenize. Used for MOTO sales."
    }
  ],
  "item": [
    {
      "name": "Card-Present",
      "description": "Operations that require the cardholder to present their card at a connected PAX terminal.\n\nAll requests return 202 Accepted immediately. The terminal then processes the card and delivers the result via callback or polling.",
      "item": [
        {
          "name": "Sale (with callback)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Auto-generate a UUID for transactionReference",
                  "// IMPORTANT: persist this to your database BEFORE sending the request",
                  "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "  const r = Math.random() * 16 | 0;",
                  "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "});",
                  "pm.collectionVariables.set('transaction_reference', uuid());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionResultId) {",
                  "    pm.collectionVariables.set('transaction_result_id', body.transactionResultId);",
                  "    console.log('transactionResultId:', body.transactionResultId);",
                  "    console.log('Now polling GET /transaction-result/{{transaction_result_id}}');",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"sale\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"customerReference\": \"order-5248\",\n  \"transactionReference\": \"{{transaction_reference}}\",\n  \"callbackUrl\": \"{{callback_url}}\",\n  \"token\": \"{{webhook_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Standard card-present sale. The terminal prompts the cardholder to tap, insert, or swipe.\n\n**amount** — smallest currency unit. `\"1000\"` = $10.00 USD or €10.00 EUR.\n\n**callbackUrl** — Handpoint POSTs the TransactionResult to this URL when the transaction completes. The response includes the AUTH-TOKEN header set to your `token` value. Validate this on receipt.\n\n**transactionReference** — UUID v4. Persist to your database BEFORE this POST — needed for recovery if your server crashes or the callback is not received.\n\nThe pre-request script auto-generates a UUID. The test script saves `transactionResultId` for use in the Get Transaction Result request."
          },
          "response": [
            {
              "name": "202 Accepted",
              "status": "Accepted",
              "code": 202,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"statusMessage\": \"Operation Accepted\",\n  \"transactionResultId\": \"082104578-1786020446467\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "Callback payload — AUTHORISED",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "AUTH-TOKEN", "value": "my-secret-webhook-token" }
              ],
              "body": "{\n  \"finStatus\": \"AUTHORISED\",\n  \"transactionID\": \"e6254050-65ab-11f1-a9af-ffa530c6e21f\",\n  \"transactionReference\": \"2bfde1fc-23b1-4c67-93d9-1d4a557f4d4f\",\n  \"type\": \"SALE\",\n  \"statusMessage\": \"Approved\",\n  \"errorMessage\": \"\",\n  \"requestedAmount\": 1000,\n  \"totalAmount\": 1000,\n  \"currency\": \"USD\",\n  \"cardSchemeName\": \"Visa\",\n  \"maskedCardNumber\": \"************0936\",\n  \"authorisationCode\": \"123456\",\n  \"issuerResponseCode\": \"00\",\n  \"efttimestamp\": 1781192438000,\n  \"mid\": \"123456789010102\",\n  \"tid\": \"082104578\",\n  \"merchantReceipt\": \"<html>...</html>\",\n  \"customerReceipt\": \"<html>...</html>\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "Callback payload — DECLINED",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "AUTH-TOKEN", "value": "my-secret-webhook-token" }
              ],
              "body": "{\n  \"finStatus\": \"DECLINED\",\n  \"transactionID\": \"f3a10cd1-65ab-11f1-b4d2-aab210c7e31c\",\n  \"transactionReference\": \"2bfde1fc-23b1-4c67-93d9-1d4a557f4d4f\",\n  \"type\": \"SALE\",\n  \"statusMessage\": \"Declined\",\n  \"errorMessage\": \"Not Authorized\",\n  \"requestedAmount\": 1000,\n  \"totalAmount\": 0,\n  \"currency\": \"USD\",\n  \"cardSchemeName\": \"Visa\",\n  \"maskedCardNumber\": \"************0936\",\n  \"authorisationCode\": \"\",\n  \"issuerResponseCode\": \"05\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Sale (polling, no callback)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "  const r = Math.random() * 16 | 0;",
                  "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "});",
                  "pm.collectionVariables.set('transaction_reference', uuid());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionResultId) {",
                  "    pm.collectionVariables.set('transaction_result_id', body.transactionResultId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"sale\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"transactionReference\": \"{{transaction_reference}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Sale without a callbackUrl. Use the `transactionResultId` from the 202 response to poll `GET /transaction-result/{id}` until you get a final finStatus.\n\nPoll every 2 seconds. Stop when finStatus is anything other than IN_PROGRESS or UNDEFINED.\n\nSee the 'Get Transaction Result' request in this collection."
          },
          "response": [
            {
              "name": "202 Accepted",
              "status": "Accepted",
              "code": 202,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"statusMessage\": \"Operation Accepted\",\n  \"transactionResultId\": \"082104578-1786020446467\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Sale with Tip",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "  const r = Math.random() * 16 | 0;",
                  "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "});",
                  "pm.collectionVariables.set('transaction_reference', uuid());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionResultId) pm.collectionVariables.set('transaction_result_id', body.transactionResultId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"sale\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"transactionReference\": \"{{transaction_reference}}\",\n  \"tipConfiguration\": {\n    \"baseAmount\": \"1000\",\n    \"tipPercentages\": [10, 15, 18, 20],\n    \"enterAmountEnabled\": true,\n    \"skipEnabled\": true,\n    \"footer\": \"Thank you for visiting!\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Sale with an on-screen tip prompt. The cardholder selects a tip percentage or enters a custom amount before the card is processed.\n\n**tipConfiguration fields:**\n- `baseAmount` — the pre-tip amount (matches `amount`)\n- `tipPercentages` — array of percentages offered on screen (1–4 values)\n- `enterAmountEnabled` — allow cardholder to type a custom tip amount\n- `skipEnabled` — show a 'No tip' option\n- `footer` — optional message shown on the tip screen\n\nThe `totalAmount` in the result includes the selected tip. `tipAmount` and `tipPercentage` are populated separately.\n\nAcquirer support: EPI, EmerchantPay, Paystrax (not all acquirers support tip at terminal — check the Acquirer Capabilities Matrix)."
          },
          "response": []
        },
        {
          "name": "Sale and Tokenize",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "  const r = Math.random() * 16 | 0;",
                  "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "});",
                  "pm.collectionVariables.set('transaction_reference', uuid());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionResultId) pm.collectionVariables.set('transaction_result_id', body.transactionResultId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "ApiKeyCloud", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"saleAndTokenizeCard\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"terminal_type\": \"{{terminal_type}}\",\n  \"serial_number\": \"{{serial_number}}\",\n  \"transactionReference\": \"{{transaction_reference}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            },
            "description": "Charges the card AND returns a `cardToken` for future card-not-present charges.\n\nThe token is in the TransactionResult as `cardToken` (and `cardTokenProvider` — e.g. `PAYSAFE` or `TOKENEX`). Store it against the customer record for subsequent MOTO sales.\n\nNote: tokenization must be enabled for your merchant by Handpoint Integration Support."
          },
          "response": [
            {
              "name": "Callback — AUTHORISED with token",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"finStatus\": \"AUTHORISED\",\n  \"transactionID\": \"e6254050-65ab-11f1-a9af-ffa530c6e21f\",\n  \"type\": \"SALE\",\n  \"totalAmount\": 1000,\n  \"currency\": \"USD\",\n  \"cardToken\": \"4111111111111111\",\n  \"cardTokenProvider\": \"PAYSAFE\",\n  \"expiryDateMMYY\": \"1027\",\n  \"maskedCardNumber\": \"************1111\",\n  \"cardSchemeName\": \"Visa\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Refund",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "  const r = Math.random() * 16 | 0;",
                  "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "});",
                  "pm.collectionVariables.set('transaction_reference', uuid());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionResultId) pm.collectionVariables.set('transaction_result_id', body.transactionResultId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
